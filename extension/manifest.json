{
  "manifest_version": 3,
  "name": "Web Printer",
  "version": "0.1.3",
  "description": "保留网页样式，按指定尺寸分页，导出 PDF 或逐页图片。",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "action": {
    "default_title": "使用 Web Printer 分页导出",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "128": "icon.png"
  }
}
