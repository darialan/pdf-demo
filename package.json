{
  "name": "@darialan/web-printer",
  "version": "1.1.0",
  "description": "保留网页样式的 HTML 分页引擎，支持文字行、表格与图文内容保护，输出 PDF 和逐页 PNG。",
  "author": "darialan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darialan/web-printer.git"
  },
  "bugs": {
    "url": "https://github.com/darialan/web-printer/issues"
  },
  "homepage": "https://pdf-demo-phi.vercel.app/",
  "keywords": [
    "web-printer",
    "html-pagination",
    "pagination",
    "pdf",
    "png",
    "dom-to-image",
    "printer",
    "html2canvas",
    "jspdf"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/migration-to-web-printer.md",
    "docs/output-formats.md"
  ],
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1"
  },
  "peerDependencies": {
    "react": ">=16.8.0 || >=17.0.0 || >=18.0.0",
    "react-dom": ">=16.8.0 || >=17.0.0 || >=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "release": "node scripts/release.mjs patch",
    "release:dry": "node scripts/release.mjs --dry-run",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "prepublishOnly": "npm run test:once && npm run build:lib",
    "start": "react-scripts start",
    "build": "PUBLIC_URL=/ react-scripts build",
    "build:lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.lib.json && node scripts/write-type-entries.mjs",
    "test": "react-scripts test",
    "test:once": "react-scripts test --watchAll=false",
    "eject": "react-scripts eject",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:once -- --runInBand && npm run build:lib && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.2.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/antd": "^1.0.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.60",
    "@types/react": "^18.2.33",
    "@types/react-dom": "^18.2.14",
    "@vercel/analytics": "^2.0.1",
    "antd": "^5.10.3",
    "caniuse-lite": "^1.0.30001820",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "vite": "^4.5.0",
    "web-vitals": "^2.1.4"
  },
  "jest": {
    "moduleNameMapper": {
      "^@darialan/web-printer$": "<rootDir>/src/lib/index.ts",
      "^@darialan/web-printer/react$": "<rootDir>/src/lib/react.ts",
      "^@vercel/analytics$": "<rootDir>/node_modules/@vercel/analytics/dist/index.js"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "typesVersions": {
    "*": {
      "react": [
        "dist/types/react.d.ts"
      ]
    }
  }
}
