{
  "name": "@darialan/web-pdf-printer",
  "version": "1.0.0",
  "description": "高性能客户端 DOM 分页与 PDF 导出引擎（防文字截断、防表格跨页腰斩、计算样式冻结与低内存按页微切片）",
  "author": "darialan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janice143/web-pdf-printer.git"
  },
  "bugs": {
    "url": "https://github.com/janice143/web-pdf-printer/issues"
  },
  "homepage": "https://github.com/janice143/web-pdf-printer#readme",
  "keywords": [
    "pdf",
    "printer",
    "html2canvas",
    "jspdf",
    "pagination",
    "dom-to-pdf",
    "avoid-cut-off",
    "web-pdf-printer",
    "darialan"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/npm-package-guide.md"
  ],
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/antd": "^1.0.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.60",
    "@types/react": "^18.2.33",
    "@types/react-dom": "^18.2.14",
    "antd": "^5.10.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "peerDependencies": {
    "html2canvas": ">=1.4.0",
    "jspdf": ">=2.5.0",
    "react": ">=16.8.0 || >=17.0.0 || >=18.0.0",
    "react-dom": ">=16.8.0 || >=17.0.0 || >=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.lib.json && node -e \"require('fs').writeFileSync('dist/index.d.ts', \\\"export * from './types/lib/index';\\\\n\\\")\"",
    "test": "react-scripts test",
    "test:once": "react-scripts test --watchAll=false",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "css-loader": "^6.7.3",
    "less": "^4.1.3",
    "less-loader": "^11.1.0",
    "style-loader": "^3.3.2",
    "typescript": "^4.9.3",
    "vite": "^4.0.0",
    "esbuild": "0.16.8"
  }
}
